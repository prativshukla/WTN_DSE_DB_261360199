7.Create a Procedure that will insert into the EMP_TEST table  the employees who working in a given deptno and also update the employees salary in emp table by 20% in EMP table. 
Use Parameter Cursor, For Loop Cursor, Update clause Cursor.
QUERY: - 
CREATE OR REPLACE PROCEDURE process_dept_emp (
    p_deptno IN emp.deptno%TYPE
) IS
    -- 1. Parameterized cursor with FOR UPDATE clause
    CURSOR c_emp (p_dept IN emp.deptno%TYPE) IS
        SELECT empno, ename, job, mgr, hiredate, sal, comm, deptno
        FROM emp
        WHERE deptno = p_dept
        FOR UPDATE OF sal;

    v_count NUMBER := 0;
BEGIN
    -- 2. Cursor FOR loop using the parameterized cursor
    FOR rec IN c_emp(p_deptno) LOOP
        -- Insert employee into EMP_TEST table
        INSERT INTO emp_test (
            empno, ename, job, mgr, hiredate, sal, comm, deptno
        ) VALUES (
            rec.empno, rec.ename, rec.job, rec.mgr, rec.hiredate, rec.sal, rec.comm, rec.deptno
        );

        -- 3. Update employee salary by 20% using WHERE CURRENT OF clause
        UPDATE emp
        SET sal = sal * 1.20
        WHERE CURRENT OF c_emp;

        v_count := v_count + 1;
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('Successfully processed ' || v_count || ' employee(s) for Department ' || p_deptno);
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END process_dept_emp;
/


8.Create a Procedure that will delete all the employees from EMP Table for a given deptno and also insert those employees in TEST table. 
Use Parameter Cursor, Update Clause Cursor, For Loop Cursor
QUERY: - 
CREATE OR REPLACE PROCEDURE delete_and_archive_emp (
    p_deptno IN emp.deptno%TYPE
) IS
    -- 1. Parameterized cursor with FOR UPDATE clause
    CURSOR c_emp (p_dept IN emp.deptno%TYPE) IS
        SELECT empno, ename, job, mgr, hiredate, sal, comm, deptno
        FROM emp
        WHERE deptno = p_dept
        FOR UPDATE;

    v_count NUMBER := 0;
BEGIN
    -- 2. Cursor FOR loop using the parameterized cursor
    FOR rec IN c_emp(p_deptno) LOOP
        -- Insert employee record into TEST table
        INSERT INTO test (
            empno, ename, job, mgr, hiredate, sal, comm, deptno
        ) VALUES (
            rec.empno, rec.ename, rec.job, rec.mgr, rec.hiredate, rec.sal, rec.comm, rec.deptno
        );

        -- 3. Delete current row from EMP using WHERE CURRENT OF clause
        DELETE FROM emp
        WHERE CURRENT OF c_emp;

        v_count := v_count + 1;
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('Successfully moved ' || v_count || ' employee(s) from Department ' || p_deptno || ' to TEST table.');
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END delete_and_archive_emp;
/




9.Create a procedure GET_EMP that will take EMPNO(IN),ENAME(OUT),SAL(OUT). Handle the required the Exceptions. Call the procedure from the SQLPROMPT by defining 2 session variables and the output from these variables by passing 7788 EMPNO.
QUERY: - 
CREATE OR REPLACE PROCEDURE GET_EMP (
    p_empno IN  emp.empno%TYPE,
    p_ename OUT emp.ename%TYPE,
    p_sal   OUT emp.sal%TYPE
) IS
BEGIN
    SELECT ename, sal
    INTO p_ename, p_sal
    FROM emp
    WHERE empno = p_empno;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        p_ename := NULL;
        p_sal   := NULL;
        DBMS_OUTPUT.PUT_LINE('Error: No employee found with EMPNO ' || p_empno);
    WHEN OTHERS THEN
        p_ename := NULL;
        p_sal   := NULL;
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END GET_EMP;
/
