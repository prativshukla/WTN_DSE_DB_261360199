10.Write a procedure that take an IN OUT argument for Mobile Number. Pass the Mobile Number as 9999999999 and the procedure should return (999)999-9999.
QUERY: - 
CREATE OR REPLACE PROCEDURE format_mobile (
    p_mobile IN OUT VARCHAR2
) IS
BEGIN
    p_mobile := '(' || SUBSTR(p_mobile, 1, 3) || ')' || 
                       SUBSTR(p_mobile, 4, 3) || '-' || 
                       SUBSTR(p_mobile, 7, 4);
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END format_mobile;
/

