6. Create Procedure to Display All PNO Using BULK COLLECT
SQL
CREATE OR REPLACE PROCEDURE DISP_ALL_PNO IS
    TYPE t_pno IS TABLE OF STOCK_EMPNO.pno%TYPE;
    v_pnos t_pno;
BEGIN
    SELECT pno 
    BULK COLLECT INTO v_pnos 
    FROM STOCK_EMPNO;

    DBMS_OUTPUT.PUT_LINE('--- STOCK PNO LIST ---');
    FOR i IN 1..v_pnos.COUNT LOOP
        DBMS_OUTPUT.PUT_LINE('PNO: ' || v_pnos(i));
    END FOR;
END;
/

-- Test execution
SET SERVEROUTPUT ON;
EXEC DISP_ALL_PNO;
7. Create Procedure to Delete Records via Dynamic SQL
SQL
CREATE OR REPLACE PROCEDURE DELETE_STOCK_RECORDS (
    p_table_name IN VARCHAR2
) IS
    v_sql VARCHAR2(200);
BEGIN
    -- Dynamic SQL execution using SQL injection prevention
    v_sql := 'DELETE FROM ' || DBMS_ASSERT.ENQUOTE_NAME(p_table_name);
    
    EXECUTE IMMEDIATE v_sql;
    DBMS_OUTPUT.PUT_LINE('Successfully deleted ' || SQL%ROWCOUNT || ' rows from table: ' || p_table_name);
END;
/

-- Test execution
SET SERVEROUTPUT ON;
EXEC DELETE_STOCK_RECORDS('STOCK_EMPNO');

