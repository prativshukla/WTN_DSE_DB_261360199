
1. Create the STOCK_EMPNO Table
SQL
CREATE TABLE STOCK_EMPNO (
    pno   NUMBER(5) CONSTRAINT pk_stock_empno PRIMARY KEY,
    pname VARCHAR2(50) CONSTRAINT nn_stock_pname NOT NULL,
    price NUMBER(10, 2),
    qty   NUMBER(10)
);
