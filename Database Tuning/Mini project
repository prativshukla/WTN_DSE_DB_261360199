4. Create Function to Return Total Amount (price * qty)
SQL
CREATE OR REPLACE FUNCTION GET_TOTAL_AMOUNT 
RETURN NUMBER IS
    v_total NUMBER;
BEGIN
    SELECT SUM(price * qty)
    INTO v_total
    FROM STOCK_EMPNO;

    RETURN v_total;
END;
/

-- Test execution
SELECT GET_TOTAL_AMOUNT AS total_stock_amount FROM dual;
